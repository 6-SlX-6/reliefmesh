# ReliefMesh production configuration. Copy to .env and fill in every value.
# Generate secrets with: ../scripts/generate-secrets.sh
# NEVER commit the filled-in .env file.

# Public hostname (DNS must point to this server; ports 80/443 open).
RELIEFMESH_DOMAIN=relief.example.org
# E-mail for Let's Encrypt certificate notices (optional but recommended).
ACME_EMAIL=

# Image version to run.
RELIEFMESH_VERSION=0.1.0

# PostgreSQL password (long random string).
POSTGRES_PASSWORD=

# Session/CSRF secret: at least 32 random characters (openssl rand -base64 48).
RELIEFMESH_SECRET_KEY=

# Encryption keys for protected data (exact locations, contact details).
# Format: id:base64-32-byte-key[,older-id:older-key]. The FIRST key encrypts
# new data; keep older keys listed until data was re-encrypted.
# Generate: echo "k1:$(openssl rand -base64 32)"
# LOSING THIS KEY MAKES PROTECTED DATA UNREADABLE. Back it up separately.
RELIEFMESH_DATA_ENCRYPTION_KEYS=

# debug | info | warn | error
RELIEFMESH_LOG_LEVEL=info
