# Local development defaults for running the API on the host (make api-run).
# These values are PUBLIC and must never be used in production.
# Production configuration lives in infrastructure/compose/.env.example.
RELIEFMESH_ENV=development
RELIEFMESH_LISTEN_ADDR=:8080
RELIEFMESH_DATABASE_URL=postgres://reliefmesh:reliefmesh@localhost:5432/reliefmesh?sslmode=disable
RELIEFMESH_PUBLIC_ORIGIN=http://localhost:3000
RELIEFMESH_EXTRA_ALLOWED_ORIGINS=http://localhost:8080
RELIEFMESH_SECRET_KEY=development-only-secret-key-change-me-0123456789
RELIEFMESH_DATA_ENCRYPTION_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RELIEFMESH_ALLOW_DEMO_SEED=true
RELIEFMESH_LOG_LEVEL=debug
